{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "data-science-skills",
  "version": "1.16.0",
  "description": "Skills for data preparation, model training, deployment, predictions, and monitoring.",
  "author": {
    "name": "DataRobot",
    "url": "https://www.datarobot.com/"
  },
  "homepage": "https://github.com/datarobot-oss/datarobot-agent-skills",
  "repository": "https://github.com/datarobot-oss/datarobot-agent-skills",
  "license": "Apache-2.0",
  "keywords": [
    "machine-learning",
    "mlops"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Data Science Skills",
        "shortDescription": "Data science workflows",
        "longDescription": "Use these skills to prepare data, train and deploy models, make predictions, and monitor them. They guide Python SDK and CLI workflows with practical instructions and supporting utilities.",
        "developerName": "DataRobot",
        "category": "Developer Tools",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "Help me train and deploy a model.",
          "Help me prepare data and start an AutoML project."
        ],
        "websiteURL": "https://github.com/datarobot-oss/datarobot-agent-skills",
        "supportURL": "https://github.com/datarobot-oss/datarobot-agent-skills/issues",
        "privacyPolicyURL": "https://www.datarobot.com/privacy/",
        "termsOfServiceURL": "https://www.datarobot.com/legal/",
        "logo": "./assets/datarobot-icon.png",
        "composerIcon": "./assets/datarobot-icon.png",
        "brandColor": "#5C41FF"
      },
      "review": {
        "commerce": false,
        "commerce_description": "The plugin does not offer payments or purchases."
      },
      "publication": {
        "release_notes": "Initial public release.",
        "countries": []
      }
    }
  }
}
